# ROS2 colcon build artifacts
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtualenv
fleet-env/

# Databases
*.db
*.sqlite3

# Generated reports
reports/*.pdf
reports/*.html

# CI-generated traceability report (regenerated each run)
reports/traceability_latest.json

# Agentic loop output (regenerated each run)
reports/mission_plan.json

# Mission photos — live at ~/fleet-ci-data/photos (PHOTO_DIR, sibling of the
# telemetry DB) since the Piece 4 absolute-path fix; never repo-relative again
reports/photos/

# Container-entrypoint autopsy logs (container_entrypoint.sh) — root-owned, accumulate
# forever. Was reports/nav2_container_*.log only until 2026-08-11, when a real gap was
# found live: reports/sensors_container_*.log (the smoke_test branch's own log, same
# file since 2026-08-05) was NEVER covered — a git clean -fd run against the Jetson's
# checkout (scripts/hil_stage.sh sync's self-healing fix) deleted 6 real, uncommitted
# sensors_container_*.log files as an unintended side effect of testing that fix, since
# they weren't gitignored and therefore weren't "untracked-but-safe" the way this
# pattern's own comment assumed. Broadened to a wildcard so any FUTURE container-log
# name sharing this `<name>_container_TIMESTAMP.log` convention is covered automatically,
# not just today's two known names.
reports/*_container_*.log

# Failure-bag evidence (rosbag2 dirs) — BAG_DIR is deliberately checkout-relative
# (failure_bag.py), unlike photos/DB, but still shouldn't be committed
reports/failure_bags/

# Pulled ROS2 log sessions (tools/pull_ros_logs.py) — debugging artifact, not source
reports/ros_logs/

# Generated maps (from SLAM)
maps/*.pgm
maps/*.yaml
!maps/.gitkeep

# Environment secrets
.env
*.env

# Internal planning/todo docs (Release1Todo.md, Releases2Plus.md) — contain
# personal/career commentary never redacted for the public repo; kept locally
# for a single non-fragmented planning home, never committed. See CLAUDE.md's
# reference_synthetic_fleet_repo / project memory for the 2026-08-01 decision.
planning/

# IDE
.vscode/settings.json
.idea/

# Playwright MCP tool scratch output
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# LibreOffice lock files
.~lock.*#

# git worktrees for isolated feature work (superpowers:using-git-worktrees)
.worktrees/
