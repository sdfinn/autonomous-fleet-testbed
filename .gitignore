# ROS2 colcon build artifacts
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/

# Virtualenv
fleet-env/

# Databases
*.db
*.sqlite3

# Generated reports
reports/*.pdf
reports/*.html

# CI-generated traceability report (regenerated each run)
reports/traceability_latest.json

# Agentic loop output (regenerated each run)
reports/mission_plan.json

# Mission photos — live at ~/fleet-ci-data/photos (PHOTO_DIR, sibling of the
# telemetry DB) since the Piece 4 absolute-path fix; never repo-relative again
reports/photos/

# Failure-bag evidence (rosbag2 dirs) — BAG_DIR is deliberately checkout-relative
# (failure_bag.py), unlike photos/DB, but still shouldn't be committed
reports/failure_bags/

# Generated maps (from SLAM)
maps/*.pgm
maps/*.yaml
!maps/.gitkeep

# Environment secrets
.env
*.env

# IDE
.vscode/settings.json
.idea/

# Playwright MCP tool scratch output
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# LibreOffice lock files
.~lock.*#
