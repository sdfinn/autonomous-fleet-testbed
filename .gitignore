reports/*.pdf
reports/*.html

# CI-generated traceability report (regenerated each run)
reports/traceability_latest.json

# Agentic loop output (regenerated each run)
reports/mission_plan.json

# Mission photos — live at ~/fleet-ci-data/photos (PHOTO_DIR, sibling of the
# telemetry DB) since the Piece 4 absolute-path fix; never repo-relative again
reports/photos/

# Failure-bag evidence (rosbag2 dirs) — BAG_DIR is deliberately checkout-relative
# (failure_bag.py), unlike photos/DB, but still shouldn't be committed
reports/failure_bags/

# Pulled ROS2 log sessions (tools/pull_ros_logs.py) — debugging artifact, not source
reports/ros_logs/

# Generated maps (from SLAM)
maps/*.pgm
maps/*.yaml
!maps/.gitkeep

# Environment secrets
.env
*.env

# Internal planning/todo docs (Release1Todo.md, Releases2Plus.md) — contain
# personal/career commentary never redacted for the public repo; kept locally
# for a single non-fragmented planning home, never committed. See CLAUDE.md's
# reference_synthetic_fleet_repo / project memory for the 2026-08-01 decision.
planning/

# IDE
.vscode/settings.json
.idea/

# Playwright MCP tool scratch output
.playwright-mcp/

